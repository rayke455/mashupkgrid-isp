# ==============================================================================
# PRODUCTION CONFIGURATION -- mashuphost.tech
# ==============================================================================
# Copy to .env.production ON THE SERVER ONLY. .env.production is gitignored; this
# .example file is committed, so it must never contain a real value.
#
#   cp .env.production.example .env.production
#   # then fill every YOUR_* / CHANGE_ME below
# ==============================================================================

# --- Core ---
NODE_ENV=production
PLATFORM_BASE_DOMAIN=mashuphost.tech

# --- Database ---
# POSTGRES_* are consumed by the postgres container in docker-compose.prod.yml.
# DATABASE_URL is what the apps connect with -- keep the user/password/db in sync.
POSTGRES_USER=mashupkgrid
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=mashupkgrid_isp
DATABASE_URL=postgresql://mashupkgrid:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/mashupkgrid_isp?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth secrets ---
# Generate each one separately, on the server:  openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_PEPPER=CHANGE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# --- API (Fastify) ---
API_PORT=4000
API_HOST=0.0.0.0
# Caddy sits in front of the API in this deployment, so X-Forwarded-For is set by a proxy we
# control and request.ip must follow it. Left at the default "false", every request would look
# like it came from Caddy: per-IP rate limiting becomes one global bucket (a single abusive
# client throttles everyone) and every audit log row records the proxy instead of the customer.
TRUST_PROXY=true
CORS_ORIGIN=https://mashuphost.tech,https://www.mashuphost.tech,https://app.mashuphost.tech,https://admin.mashuphost.tech,https://wifi.mashuphost.tech,https://portal.mashuphost.tech
APP_API_PUBLIC_URL=https://api.mashuphost.tech

# --- Web (Next.js) ---
# NEXT_PUBLIC_API_URL is inlined at BUILD time (see infrastructure/docker/web.Dockerfile).
# Changing it requires: docker compose -f docker-compose.prod.yml build web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.mashuphost.tech
APP_WEB_URL=https://mashuphost.tech

# --- Worker / RADIUS ---
WORKER_CONCURRENCY=10
ENABLE_EMBEDDED_RADIUS_SERVER=true
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# --- WireGuard remote access ---
# Left OFF deliberately. packages/network/src/wireguard-peer.service.ts shells out to `wg set`,
# which manages an interface in the HOST network namespace -- it cannot work from inside the
# bridged worker container. Enable only after running the worker on the host (or a host-network
# sidecar with NET_ADMIN). See docs/deployment/README.md.
ENABLE_WIREGUARD_REMOTE_ACCESS=false
WIREGUARD_INTERFACE=wg0
WIREGUARD_SERVER_PUBLIC_KEY=YOUR_WIREGUARD_PUBLIC_KEY
WIREGUARD_SERVER_ENDPOINT=YOUR_AZURE_PUBLIC_IP:51820
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_SUBNET_CIDR=10.90.0.0/16

# --- Safaricom Daraja M-Pesa (production) ---
# Per-tenant credentials are configured in the admin UI and encrypted at rest; these are the
# platform-level fallback.
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=YOUR_LIVE_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_LIVE_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_LIVE_PAYBILL_OR_TILL
MPESA_PASSKEY=YOUR_LIVE_LIPA_NA_MPESA_PASSKEY
MPESA_CALLBACK_URL=https://api.mashuphost.tech/api/v1/portal/mpesa/callback

# --- SMS gateway ---
SMS_PROVIDER=africastalking
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER_ID=YOUR_SMS_SENDER_ID
