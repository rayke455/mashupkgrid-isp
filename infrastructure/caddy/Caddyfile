# Caddyfile for mashuphost.tech
#
# Certificates are issued over the ACME DNS-01 challenge via Cloudflare. DNS-01 is required
# (not merely preferred) because of the *.mashuphost.tech wildcard below: Let's Encrypt will
# not issue a wildcard over HTTP-01. That means Caddy needs the Cloudflare DNS module:
#
#   sudo caddy add-package github.com/caddy-dns/cloudflare
#   sudo systemctl restart caddy
#
# and a scoped Cloudflare API token (Zone:DNS:Edit + Zone:Zone:Read on mashuphost.tech only)
# exposed to the caddy service as CLOUDFLARE_API_TOKEN. See docs/deployment/README.md.
{
    email admin@mashuphost.tech
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# For hosts reached DIRECTLY (Cloudflare grey cloud / DNS-only): api and the tenant wildcard.
# X-Forwarded-For is REPLACED with the connecting peer, never appended to. Appending would let
# a client send its own X-Forwarded-For and have it survive as the left-most entry, which is
# what request.ip resolves to under TRUST_PROXY=true -- spoofing per-IP rate limiting and the
# maintenance-mode IP allowlist.
(proxy_headers) {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
}

# For hosts behind the Cloudflare proxy (orange cloud): the web surface.
# There, {remote_host} is a Cloudflare edge node, so every visitor would look like Cloudflare.
# CF-Connecting-IP carries the real client address and is set by Cloudflare's edge, which also
# strips any client-supplied copy -- so it is trustworthy in a way a raw X-Forwarded-For is not.
(proxy_headers_cf) {
    header_up Host {host}
    header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
    header_up X-Forwarded-Proto {scheme}
}

(hardening) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

# 1. Main website, ISP dashboard, and platform admin
mashuphost.tech, www.mashuphost.tech, admin.mashuphost.tech {
    import hardening
    reverse_proxy localhost:3000 {
        import proxy_headers_cf
    }
}

# 2. Customer super app ("FiberConnect")
app.mashuphost.tech {
    import hardening
    # Guard against double-prefixing. An unguarded `rewrite * /app{uri}` turns "/" into
    # "/app/", Next.js 308-redirects that to "/app", and the browser's follow-up request
    # gets rewritten again into "/app/app". Skipping the rewrite when the path is already
    # under /app lets that redirect land.
    @needs_prefix not path /app /app/*
    rewrite @needs_prefix /app{uri}
    reverse_proxy localhost:3000 {
        import proxy_headers_cf
    }
}

# 3. Wi-Fi hotspot captive portal
wifi.mashuphost.tech, portal.mashuphost.tech {
    import hardening
    # Same double-prefix guard as the app subdomain above -- without it these hosts 404,
    # because "/vouchers" gets rewritten a second time into "/vouchers/vouchers".
    @needs_prefix not path /vouchers /vouchers/*
    rewrite @needs_prefix /vouchers{uri}
    reverse_proxy localhost:3000 {
        import proxy_headers_cf
    }
}

# 4. Fastify REST API and M-Pesa callback webhooks.
# No HSTS preload games here -- Safaricom posts callbacks to this host.
api.mashuphost.tech {
    import hardening
    reverse_proxy localhost:4000 {
        import proxy_headers
    }
}

# 5. Wildcard multi-tenant subdomains. Listed last: Caddy matches the most specific site
# block first, so the explicit hosts above still win.
*.mashuphost.tech {
    import hardening
    reverse_proxy localhost:3000 {
        import proxy_headers
    }
}
